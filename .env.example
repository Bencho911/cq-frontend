# API Gateway del ecosistema Kiora.
# - En local (backend en :3000): deja vacío y el cliente usará http://localhost:3000/api en dev.
# - En producción: URL absoluta del gateway, p. ej. https://api.kiorapp.xyz/api
VITE_API_URL=

# Llave pública del kiosco para crear pedidos sin JWT (coincide con KIOSK_API_KEY del gateway).
VITE_KIOSK_API_KEY=

# true (por defecto) = usar datos locales mock cuando el backend no está disponible.
# false = llamar siempre al backend real.
VITE_USE_MOCKS=true
